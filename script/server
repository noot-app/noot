#!/usr/bin/env bash

set -euo pipefail

source script/env "$@"

function usage() {
    echo "Usage: $0 [--clean]"
    echo ""
    echo "Options:"
    echo "  --clean       Reset database and start server (calls script/db reset)"
    echo ""
    echo "Without options, starts the server with the existing database."
    echo "This script will automatically start Supabase if it is not running."
    exit 1
}

function check_and_start_supabase() {    
    # Check if supabase command is available
    if ! command -v supabase &> /dev/null; then
        echo -e "${RED}❌ Supabase CLI is required but not installed${OFF}"
        echo "Install it with: brew install supabase/tap/supabase"
        exit 1
    fi
    
    echo -e "${BLUE}🔍 Checking Supabase stack status...${OFF}"
    
    # Check if Supabase is running by trying to connect to the API
    if curl -s --connect-timeout 2 "http://127.0.0.1:54321/health" > /dev/null 2>&1; then
        echo -e "${GREEN}✅ Supabase stack is already running${OFF}"
        return 0
    fi
    
    echo -e "${BLUE}⚠️  Supabase stack is not running${OFF}"
    echo -e "${BLUE}🚀 Starting Supabase stack...${OFF}"
    
    # Start supabase (this will run migrations + seed automatically)
    if supabase start; then
        echo -e "${GREEN}✅ Supabase stack started successfully${OFF}"
        
        # Wait for services to be fully ready
        echo -e "${BLUE}⏳ Waiting for services to be ready...${OFF}"
        local max_attempts=30
        local attempt=1
        
        while [[ $attempt -le $max_attempts ]]; do
            if curl -s --connect-timeout 1 "http://127.0.0.1:54321/health" > /dev/null 2>&1; then
                echo -e "${GREEN}✅ All services are ready${OFF}"
                return 0
            fi
            
            echo -e "${BLUE}⏳ Attempt $attempt/$max_attempts - waiting for services...${OFF}"
            sleep 2
            ((attempt++))
        done
        
        echo -e "${RED}❌ Services did not become ready within expected time${OFF}"
        exit 1
    else
        echo -e "${RED}❌ Failed to start Supabase stack${OFF}"
        exit 1
    fi
}

function quick_clean_and_start() {
    echo -e "${BLUE}🧹 Quick cleaning database and starting server...${OFF}"
    
    # Ensure Supabase is running if needed
    check_and_start_supabase

    # Reset the database using our dedicated script
    echo -e "${BLUE}📊 Resetting database...${OFF}"
    script/db reset
    
    echo -e "${GREEN}✅ Database reset and seeded${OFF}"
    echo -e "${BLUE}🚀 Starting server...${OFF}"
    echo ""
    
    # Start the server
    go run ./cmd/noot/main.go
}

function start_server() {
    echo -e "${BLUE}🚀 Starting server...${OFF}"

    check_and_start_supabase
    
    go run ./cmd/noot/main.go
}

# Parse command line arguments
case "${1:-}" in
    --clean)
        quick_clean_and_start
        ;;
    --help|-h|help)
        usage
        ;;
    "")
        start_server
        ;;
    *)
        echo -e "${RED}❌ Unknown option: $1${OFF}"
        echo ""
        usage
        ;;
esac
