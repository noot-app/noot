#!/usr/bin/env bash

# 📧 monalisa@birki.io / password123 (pro tier)
# 📧 alice@birki.io / password123 (free tier)

set -euo pipefail

source script/env "$@"

function usage() {
    echo "Usage: $0 [--clean | --quick | reset [--production] | test | diff]"
    echo ""
    echo "Options:"
    echo "  --clean         Full reset: stop Supabase, restart, and run all migrations + seed"
    echo "  --quick         Quick reset: reset database without restarting services, run migrations + seed"
    echo "  reset           Run supabase db reset on local development database"
    echo "  reset --production  Run supabase db reset on linked production database (with warning)"
    echo "  test            Run database integration tests"
    echo "  diff            Show schema differences between local migrations and production database"
    echo ""
    echo "This script leverages Supabase's built-in seeding via supabase/seed.sql"
    echo "Creates seed users for development:"
    echo "  - monalisa@birki.io (handle: monalisa, tier: pro)"
    echo "  - alice@birki.io (handle: alice, tier: free)"
    exit 1
}

function check_requirements() {
    if ! command -v supabase &> /dev/null; then
        echo -e "${RED}❌ Supabase CLI is required but not installed${OFF}"
        echo "Install it with: brew install supabase/tap/supabase"
        exit 1
    fi
}

function confirm_production_reset() {
    echo -e "${RED}⚠️  WARNING: PRODUCTION DATABASE RESET ⚠️${OFF}"
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${OFF}"
    echo -e "${RED}This will PERMANENTLY DELETE all data in your production database!${OFF}"
    echo -e "${RED}This action cannot be undone!${OFF}"
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${OFF}"
    echo ""
    read -p "Type 'RESET_PRODUCTION_DATABASE' to confirm: " confirmation
    
    if [[ "$confirmation" != "RESET_PRODUCTION_DATABASE" ]]; then
        echo -e "${GREEN}✅ Production reset cancelled${OFF}"
        exit 0
    fi
}

function run_reset() {
    local production_flag="$1"
    
    echo -e "${BLUE}🔄 Running Supabase database reset...${OFF}"
    
    if [[ "$production_flag" == "true" ]]; then
        confirm_production_reset
        echo -e "${PURPLE}⚡ Resetting production database...${OFF}"
        echo -e "${YELLOW}Note: By default the reset will run with --no-seed to avoid filling the production database with dev users.${OFF}"
        read -p "Do you want to ENABLE seeding? This is NOT the default. (y/N) default is to just say (n): " enable_seed
        if [[ "$enable_seed" =~ ^[Yy]$ ]]; then
            echo -e "${YELLOW}⚠️  You chose to ENABLE seeding. This will run without --no-seed.${OFF}"
            supabase db reset --linked
        else
            supabase db reset --linked --no-seed
        fi
    else
        echo -e "${PURPLE}⚡ Resetting local development database...${OFF}"
        supabase db reset
    fi
    
    echo -e "${GREEN}✅ Database reset completed${OFF}"
}

function run_clean() {
    check_requirements
    
    echo -e "${BLUE}🧹 Full clean reset: stopping Supabase, restarting, and running migrations + seed...${OFF}"
    
    supabase stop
    supabase start
    supabase db reset
    
    echo -e "${GREEN}✅ Clean reset completed${OFF}"
}

function run_quick() {
    check_requirements
    
    echo -e "${BLUE}⚡ Quick reset: resetting database without restarting services, running migrations + seed...${OFF}"
    
    supabase db reset
    
    echo -e "${GREEN}✅ Quick reset completed${OFF}"
}

function run_test() {
    echo -e "${BLUE}🧪 Running database integration tests...${OFF}"
    
    # Ensure Go is available
    if ! command -v go &> /dev/null; then
        echo -e "${RED}❌ Go is required but not installed${OFF}"
        exit 1
    fi
    
    # Run the database tests with vendor modules
    go test -mod=vendor -v ./supabase/tests/... -count=1
    
    echo -e "${GREEN}✅ Database tests completed${OFF}"
}

function run_diff_production() {
    check_requirements
    
    echo -e "${BLUE}🔍 Comparing local migrations with production database...${OFF}"
    echo -e "${YELLOW}This will show schema differences between your local migrations and the linked production database.${OFF}"
    echo ""
    
    # Run the diff command
    if supabase db diff --linked; then
        echo ""
        echo -e "${GREEN}✅ Schema diff completed${OFF}"
        echo -e "${BLUE}💡 If no output was shown above, your local migrations are in sync with production${OFF}"
    else
        echo ""
        echo -e "${RED}❌ Failed to diff against production database${OFF}"
        echo -e "${YELLOW}Make sure you have a linked Supabase project configured${OFF}"
        exit 1
    fi
}

function main() {
    check_requirements
    
    if [[ $# -eq 0 ]]; then
        usage
    fi
    
    case "${1}" in
        --clean)
            run_clean
            ;;
        --quick)
            run_quick
            ;;
        reset)
            local production_flag="false"
            
            # Check for --production flag
            if [[ $# -gt 1 && "${2}" == "--production" ]]; then
                production_flag="true"
            fi
            
            run_reset "$production_flag"
            ;;
        test)
            run_test
            ;;
        diff)
            run_diff_production
            ;;
        -h|--help|help)
            usage
            ;;
        *)
            echo -e "${RED}❌ Unknown option: ${1}${OFF}"
            echo ""
            usage
            ;;
    esac
}

main "$@"
