# Noot React Native App Configuration
# Copy this file to .env and adjust the values for your environment

# API Backend URL
# For development with local backend server
EXPO_PUBLIC_API_URL=http://localhost:3000

# For development with backend running on different host
# EXPO_PUBLIC_API_URL=http://192.168.1.100:3000

# For production deployment
# EXPO_PUBLIC_API_URL=https://your-production-backend.com