        "required": [
          "calories",
          "protein_g",
          "total_fat_g",
          "saturated_fat_g",
          "trans_fat_g",
          "cholesterol_mg",
          "sodium_mg",
          "total_carbs_g",
          "dietary_fiber_g",
          "total_sugars_g",
