#!/usr/bin/env bash

# Interactive script to add a new nutrient to the noot application
# This script automates the process documented in docs/adding-nutrients.md

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
OFF='\033[0m'

# Global variables for rollback
BACKUP_DIR=""
CHANGED_FILES=()

# Show usage information
show_help() {
    echo "Usage: $0 [OPTIONS]"
    echo
    echo "Interactive script to add a new nutrient to the noot application."
    echo
    echo "Options:"
    echo "  -h, --help     Show this help message"
    echo "  -v, --verbose  Show verbose output including diffs"
    echo "  --dry-run      Show what would be changed without making changes"
    echo
    echo "This script will:"
    echo "  1. Create database migration files"
    echo "  2. Update Go structs (CompleteNutrient, Consumption, Item, NutritionSummary)"
    echo "  3. Update OpenAPI schema definitions"
    echo "  4. Regenerate API types"
    echo "  5. Update frontend Goals component"
    echo "  6. Run validation tests"
    echo "  7. Provide rollback capability if anything fails"
    echo
    echo "Example:"
    echo "  $0                    # Interactive mode"
    echo "  $0 --verbose          # Show detailed changes"
    echo "  $0 --dry-run          # Preview changes without applying"
}

# Parse command line arguments
VERBOSE=false
DRY_RUN=false

while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            show_help
            exit 0
            ;;
        -v|--verbose)
            VERBOSE=true
            shift
            ;;
        --dry-run)
            DRY_RUN=true
            shift
            ;;
        *)
            echo -e "${RED}Unknown option: $1${OFF}"
            show_help
            exit 1
            ;;
    esac
done

# Cleanup function for rollback
cleanup_and_rollback() {
    local exit_code=$1
    if [[ $exit_code -ne 0 && -n "$BACKUP_DIR" && -d "$BACKUP_DIR" ]]; then
        echo -e "${RED}Error occurred. Rolling back changes...${OFF}"
        
        for file in "${CHANGED_FILES[@]}"; do
            if [[ -f "$BACKUP_DIR/$(basename "$file")" ]]; then
                cp "$BACKUP_DIR/$(basename "$file")" "$file"
                echo -e "${YELLOW}Restored: $file${OFF}"
            fi
        done
        
        # Remove any created migration files
        if [[ -n "${MIGRATION_FILE:-}" && -f "$MIGRATION_FILE" ]]; then
            rm -f "$MIGRATION_FILE"
            echo -e "${YELLOW}Removed: $MIGRATION_FILE${OFF}"
        fi
        
        echo -e "${RED}Rollback complete. No permanent changes made.${OFF}"
        rm -rf "$BACKUP_DIR" 2>/dev/null || true
    fi
}

# Set trap for cleanup
trap 'cleanup_and_rollback $?' EXIT

# Function to create backup
create_backup() {
    BACKUP_DIR=$(mktemp -d)
    echo -e "${BLUE}Creating backup in: $BACKUP_DIR${OFF}"
}

# Function to backup a file
backup_file() {
    local file=$1
    if [[ -f "$file" ]]; then
        cp "$file" "$BACKUP_DIR/$(basename "$file")"
        CHANGED_FILES+=("$file")
    fi
}

# Function to validate Go compilation
validate_build() {
    echo -e "${BLUE}🔍 Validating Go compilation...${OFF}"
    if go build -v ./cmd/noot > /dev/null 2>&1; then
        echo -e "${GREEN}✓ Go compilation successful${OFF}"
        return 0
    else
        echo -e "${RED}✗ Go compilation failed${OFF}"
        echo "Please check the error above and fix any syntax issues."
        return 1
    fi
}

# Function to show diff preview
show_diff_preview() {
    local file=$1
    local backup_file="$BACKUP_DIR/$(basename "$file")"
    
    if [[ -f "$backup_file" ]]; then
        if [[ "$VERBOSE" == true ]] || [[ "$DRY_RUN" == true ]]; then
            echo -e "${BLUE}Changes to $file:${OFF}"
            if command -v colordiff >/dev/null 2>&1; then
                colordiff -u "$backup_file" "$file" || true
            else
                diff -u "$backup_file" "$file" || true
            fi
            echo
        fi
    fi
}

# Function to apply changes (or just preview in dry-run mode)
apply_or_preview() {
    local description=$1
    local file=$2
    local sed_command=$3
    
    if [[ "$DRY_RUN" == true ]]; then
        echo -e "${BLUE}[DRY RUN] Would apply: $description${OFF}"
        echo "  File: $file"
        echo "  Command: $sed_command"
        echo
        return 0
    fi
    
    # Apply the actual change
    eval "$sed_command"
}

echo -e "${BLUE}🍎 Noot Nutrient Addition Helper${OFF}"
echo -e "${BLUE}====================================${OFF}"
echo
echo "This script will guide you through adding a new nutrient to noot."
echo "It will create the necessary database migrations, update Go structs,"
echo "modify OpenAPI schemas, and update the frontend components."
echo
if [[ "$DRY_RUN" == true ]]; then
    echo -e "${YELLOW}🔍 DRY RUN MODE: No changes will be made, only previewed.${OFF}"
else
    echo -e "${YELLOW}Note: This script creates backups and can rollback changes if issues occur.${OFF}"
fi
echo

# Create backup directory before starting (unless dry run)
if [[ "$DRY_RUN" != true ]]; then
    create_backup
fi

# Get nutrient information from user
read -p "Enter nutrient name (e.g., 'EPA', 'Beta Carotene'): " NUTRIENT_NAME
if [[ -z "$NUTRIENT_NAME" ]]; then
    echo -e "${RED}Error: Nutrient name is required${OFF}"
    exit 1
fi

read -p "Enter unit (e.g., 'mg', 'mcg', 'g'): " UNIT
if [[ -z "$UNIT" ]]; then
    echo -e "${RED}Error: Unit is required${OFF}"
    exit 1
fi

read -p "Enter short description (e.g., 'Eicosapentaenoic acid, an omega-3 fatty acid'): " DESCRIPTION
if [[ -z "$DESCRIPTION" ]]; then
    echo -e "${RED}Error: Description is required${OFF}"
    exit 1
fi

# Generate field names
NUTRIENT_LOWER=$(echo "$NUTRIENT_NAME" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/_/g' | sed 's/__*/_/g' | sed 's/^_//' | sed 's/_$//')
NUTRIENT_CAMEL=$(echo "$NUTRIENT_NAME" | sed 's/[^a-zA-Z0-9]//g')
NUTRIENT_PASCAL="${NUTRIENT_CAMEL^}"

# Column names
COL_CONSUMPTION="${NUTRIENT_LOWER}_${UNIT}"
COL_ITEMS_CACHE="${NUTRIENT_LOWER}_${UNIT}_per_100g"

# Go field names  
FIELD_NUTRIENT="${NUTRIENT_PASCAL}${UNIT^}"
FIELD_ITEMS="${NUTRIENT_PASCAL}${UNIT^}Per100g"
FIELD_SUMMARY="Total${NUTRIENT_PASCAL}${UNIT^}"

# JSON field names
JSON_NUTRIENT="${NUTRIENT_LOWER}_${UNIT}"
JSON_ITEMS="${NUTRIENT_LOWER}_${UNIT}_per_100g"
JSON_SUMMARY="total_${NUTRIENT_LOWER}_${UNIT}"

echo
echo -e "${YELLOW}Generated field names:${OFF}"
echo "  Database columns: $COL_CONSUMPTION, $COL_ITEMS_CACHE"
echo "  Go fields: $FIELD_NUTRIENT, $FIELD_ITEMS, $FIELD_SUMMARY"
echo "  JSON fields: $JSON_NUTRIENT, $JSON_ITEMS, $JSON_SUMMARY"
echo

read -p "Continue with these names? [y/N]: " CONFIRM
if [[ "$CONFIRM" != "y" && "$CONFIRM" != "Y" ]]; then
    echo "Cancelled."
    exit 0
fi

# Find next migration number
MIGRATION_DIR="internal/storage/migrations"
if [[ ! -d "$MIGRATION_DIR" ]]; then
    echo -e "${RED}Error: Migration directory not found at $MIGRATION_DIR${OFF}"
    exit 1
fi

LAST_MIGRATION=$(ls "$MIGRATION_DIR"/*.sql | sort -V | tail -1 | basename | cut -d'_' -f1)
NEXT_NUM=$(printf "%03d" $((10#$LAST_MIGRATION + 1)))
MIGRATION_FILE="$MIGRATION_DIR/${NEXT_NUM}_add_${NUTRIENT_LOWER}_nutrient.sql"

echo
echo -e "${BLUE}📄 Creating migration file: $MIGRATION_FILE${OFF}"

cat > "$MIGRATION_FILE" << EOF
-- Migration $NEXT_NUM: Add $NUTRIENT_NAME nutrient tracking
-- $DESCRIPTION

-- Add $NUTRIENT_NAME column to consumptions table for tracking totals
ALTER TABLE consumptions ADD COLUMN $COL_CONSUMPTION REAL NOT NULL DEFAULT 0;

-- Add $NUTRIENT_NAME column to items_cache table for per-100g nutrition data
ALTER TABLE items_cache ADD COLUMN $COL_ITEMS_CACHE REAL NOT NULL DEFAULT 0;
EOF

echo -e "${GREEN}✓ Created migration file${OFF}"

# Update Go structs
echo -e "${BLUE}📝 Updating Go structs...${OFF}"

# Update CompleteNutrient in types.go
TYPES_FILE="internal/server/types.go"
if [[ -f "$TYPES_FILE" ]]; then
    backup_file "$TYPES_FILE"
    
    # More robust pattern: look for the specific DHA line and add after it
    if grep -q "DHAmg float64" "$TYPES_FILE"; then
        sed -i "/DHAmg float64.*DHA.*milligrams/a\\	$FIELD_NUTRIENT float64 \`json:\"$JSON_NUTRIENT\"\` \/\/ $DESCRIPTION" "$TYPES_FILE"
        echo -e "${GREEN}✓ Updated CompleteNutrient in $TYPES_FILE${OFF}"
    else
        echo -e "${RED}✗ Could not find DHA reference in $TYPES_FILE${OFF}"
        echo "Please manually add: $FIELD_NUTRIENT float64 \`json:\"$JSON_NUTRIENT\"\` // $DESCRIPTION"
        exit 1
    fi
    
    # Validate the change was applied correctly
    if ! grep -q "$FIELD_NUTRIENT" "$TYPES_FILE"; then
        echo -e "${RED}✗ Failed to add field to $TYPES_FILE${OFF}"
        exit 1
    fi
else
    echo -e "${RED}✗ $TYPES_FILE not found${OFF}"
    exit 1
fi

# Update storage structs in store.go
STORE_FILE="internal/storage/store.go"
if [[ -f "$STORE_FILE" ]]; then
    backup_file "$STORE_FILE"
    
    # Add to Consumption struct - find DHA field and add after it
    if grep -q "DHAmg.*float64" "$STORE_FILE"; then
        sed -i "/DHAmg[[:space:]]*float64.*json:.*dha_mg/a\\	$FIELD_NUTRIENT    float64    \`json:\"$JSON_NUTRIENT\"\`" "$STORE_FILE"
        echo -e "${GREEN}✓ Updated Consumption struct in $STORE_FILE${OFF}"
    else
        echo -e "${RED}✗ Could not find DHAmg field in Consumption struct${OFF}"
        exit 1
    fi
    
    # Add to Item struct - find DHAmgPer100g and add after it  
    if grep -q "DHAmgPer100g.*float64" "$STORE_FILE"; then
        sed -i "/DHAmgPer100g[[:space:]]*float64.*json:.*dha_mg_per_100g/a\\	$FIELD_ITEMS             float64 \`json:\"$JSON_ITEMS\"\`" "$STORE_FILE"
        echo -e "${GREEN}✓ Updated Item struct in $STORE_FILE${OFF}"
    else
        echo -e "${RED}✗ Could not find DHAmgPer100g field in Item struct${OFF}"
        exit 1
    fi
    
    # Add to NutritionSummary struct - find TotalDHAmg and add after it
    if grep -q "TotalDHAmg.*float64" "$STORE_FILE"; then
        sed -i "/TotalDHAmg[[:space:]]*float64.*json:.*total_dha_mg/a\\	$FIELD_SUMMARY      float64 \`json:\"$JSON_SUMMARY\"\`" "$STORE_FILE"
        echo -e "${GREEN}✓ Updated NutritionSummary struct in $STORE_FILE${OFF}"
    else
        echo -e "${RED}✗ Could not find TotalDHAmg field in NutritionSummary struct${OFF}"
        exit 1
    fi
    
    # Validate all changes were applied
    for field in "$FIELD_NUTRIENT" "$FIELD_ITEMS" "$FIELD_SUMMARY"; do
        if ! grep -q "$field" "$STORE_FILE"; then
            echo -e "${RED}✗ Failed to add $field to $STORE_FILE${OFF}"
            exit 1
        fi
    done
    echo -e "${GREEN}✓ All struct updates validated in $STORE_FILE${OFF}"
else
    echo -e "${RED}✗ $STORE_FILE not found${OFF}"
    exit 1
fi

# Validate Go compilation after struct changes
if ! validate_build; then
    echo -e "${RED}Go compilation failed after struct updates. Please check the changes above.${OFF}"
    exit 1
fi

# Note: OpenAI nutrition prompt is now managed on OpenAI portal
echo -e "${BLUE}📝 OpenAI Nutrition Prompt Update Required${OFF}"
echo "The nutrition system prompt is managed on OpenAI's portal, not in code."
echo "After completing this script, you'll need to:"
echo "1. Access the OpenAI portal where the nutrition prompt is hosted"
echo "2. Add '$JSON_NUTRIENT': number to the JSON structure"
echo "3. Add reference data for $NUTRIENT_NAME if available"
echo "4. Update the OPENAI_NUTRITION_PROMPT_VERSION environment variable"
echo

# Update OpenAPI schema
OPENAPI_FILE="api/openapi.yaml"
if [[ -f "$OPENAPI_FILE" ]]; then
    backup_file "$OPENAPI_FILE"
    
    # Add to required fields in CompleteNutrient - find dha_mg and add after it
    if grep -q "- dha_mg" "$OPENAPI_FILE"; then
        sed -i "/^[[:space:]]*- dha_mg$/a\\        - $JSON_NUTRIENT" "$OPENAPI_FILE"
        echo -e "${GREEN}✓ Added $JSON_NUTRIENT to required fields${OFF}"
    else
        echo -e "${RED}✗ Could not find dha_mg in required fields${OFF}"
        exit 1
    fi
    
    # Add property definition after dha_mg definition
    if grep -q "dha_mg:" "$OPENAPI_FILE" && grep -A2 "dha_mg:" "$OPENAPI_FILE" | grep -q "description.*DHA"; then
        # Find the line with dha_mg description and add our nutrient after the description
        sed -i "/dha_mg:/,/description:/{
            /description:.*DHA.*milligrams/a\\        $JSON_NUTRIENT:\n          type: number\n          description: \"$DESCRIPTION\"
        }" "$OPENAPI_FILE"
        echo -e "${GREEN}✓ Added $JSON_NUTRIENT property definition${OFF}"
    else
        echo -e "${RED}✗ Could not find dha_mg property definition${OFF}"
        exit 1
    fi
    
    # Add to NutritionSummary required fields
    if grep -q "- total_dha_mg" "$OPENAPI_FILE"; then
        sed -i "/^[[:space:]]*- total_dha_mg$/a\\        - $JSON_SUMMARY" "$OPENAPI_FILE"
        echo -e "${GREEN}✓ Added $JSON_SUMMARY to NutritionSummary required fields${OFF}"
    else
        echo -e "${RED}✗ Could not find total_dha_mg in NutritionSummary required fields${OFF}"
        exit 1
    fi
    
    # Add to NutritionSummary properties
    if grep -q "total_dha_mg:" "$OPENAPI_FILE"; then
        sed -i "/total_dha_mg:/,/description:/{
            /description:.*Total DHA.*milligrams/a\\        $JSON_SUMMARY:\n          type: number\n          description: \"Total $NUTRIENT_NAME in $UNIT\"
        }" "$OPENAPI_FILE"
        echo -e "${GREEN}✓ Added $JSON_SUMMARY to NutritionSummary properties${OFF}"
    else
        echo -e "${RED}✗ Could not find total_dha_mg in NutritionSummary properties${OFF}"
        exit 1
    fi
    
    # Validate all changes were applied
    if ! grep -q "$JSON_NUTRIENT" "$OPENAPI_FILE"; then
        echo -e "${RED}✗ Failed to add $JSON_NUTRIENT to OpenAPI schema${OFF}"
        exit 1
    fi
    if ! grep -q "$JSON_SUMMARY" "$OPENAPI_FILE"; then
        echo -e "${RED}✗ Failed to add $JSON_SUMMARY to OpenAPI schema${OFF}"
        exit 1
    fi
    
    echo -e "${GREEN}✓ Updated OpenAPI schema${OFF}"
else
    echo -e "${RED}✗ $OPENAPI_FILE not found${OFF}"
    exit 1
fi

# Regenerate API types
echo -e "${BLUE}🔄 Regenerating API types...${OFF}"
if ./script/generate-types; then
    echo -e "${GREEN}✓ API types regenerated${OFF}"
else
    echo -e "${RED}✗ Failed to regenerate API types${OFF}"
    exit 1
fi

# Generate a simple validation test
echo -e "${BLUE}🧪 Generating validation test...${OFF}"
TEST_FILE="/tmp/test_${NUTRIENT_LOWER}_addition.go"
cat > "$TEST_FILE" << EOF
package main

// Simple validation test for $NUTRIENT_NAME addition
// This test verifies that all necessary structs contain the new nutrient field

import (
	"encoding/json"
	"fmt"
	"reflect"
	
	"github.com/GrantBirki/noot/internal/server"
	"github.com/GrantBirki/noot/internal/storage"
)

func main() {
	fmt.Println("🧪 Testing $NUTRIENT_NAME addition...")
	
	// Test CompleteNutrient struct has the field
	nutrient := server.CompleteNutrient{}
	nutrientType := reflect.TypeOf(nutrient)
	if _, found := nutrientType.FieldByName("$FIELD_NUTRIENT"); !found {
		fmt.Printf("❌ Field '$FIELD_NUTRIENT' not found in CompleteNutrient struct\n")
		return
	}
	fmt.Println("✓ CompleteNutrient.$FIELD_NUTRIENT field exists")
	
	// Test Consumption struct has the field
	consumption := storage.Consumption{}
	consumptionType := reflect.TypeOf(consumption)
	if _, found := consumptionType.FieldByName("$FIELD_NUTRIENT"); !found {
		fmt.Printf("❌ Field '$FIELD_NUTRIENT' not found in Consumption struct\n")
		return
	}
	fmt.Println("✓ Consumption.$FIELD_NUTRIENT field exists")
	
	// Test Item struct has the field
	item := storage.Item{}
	itemType := reflect.TypeOf(item)
	if _, found := itemType.FieldByName("$FIELD_ITEMS"); !found {
		fmt.Printf("❌ Field '$FIELD_ITEMS' not found in Item struct\n")
		return
	}
	fmt.Println("✓ Item.$FIELD_ITEMS field exists")
	
	// Test NutritionSummary struct has the field
	summary := storage.NutritionSummary{}
	summaryType := reflect.TypeOf(summary)
	if _, found := summaryType.FieldByName("$FIELD_SUMMARY"); !found {
		fmt.Printf("❌ Field '$FIELD_SUMMARY' not found in NutritionSummary struct\n")
		return
	}
	fmt.Println("✓ NutritionSummary.$FIELD_SUMMARY field exists")
	
	// Test JSON serialization works correctly
	nutrient.$FIELD_NUTRIENT = 123.45
	data, err := json.Marshal(nutrient)
	if err != nil {
		fmt.Printf("❌ JSON marshaling failed: %v\n", err)
		return
	}
	
	var unmarshaled server.CompleteNutrient
	if err := json.Unmarshal(data, &unmarshaled); err != nil {
		fmt.Printf("❌ JSON unmarshaling failed: %v\n", err)
		return
	}
	
	if unmarshaled.$FIELD_NUTRIENT != 123.45 {
		fmt.Printf("❌ JSON roundtrip failed: expected 123.45, got %f\n", unmarshaled.$FIELD_NUTRIENT)
		return
	}
	fmt.Println("✓ JSON serialization/deserialization works")
	
	fmt.Println("🎉 All $NUTRIENT_NAME validation tests passed!")
}
EOF

# Run the validation test
echo -e "${BLUE}🏃 Running validation test...${OFF}"
if go run "$TEST_FILE"; then
    echo -e "${GREEN}✓ Validation test passed${OFF}"
    rm -f "$TEST_FILE"
else
    echo -e "${RED}✗ Validation test failed${OFF}"
    echo "Test file saved at: $TEST_FILE"
    exit 1
fi

# Update frontend Goals component
GOALS_FILE="apps/web/src/lib/components/Goals.svelte"
if [[ -f "$GOALS_FILE" ]]; then
    backup_file "$GOALS_FILE"
    
    # Add to keyNutrients array after DHA
    if grep -q '"dha_mg"' "$GOALS_FILE"; then
        sed -i '/"dha_mg",/a\    "'$JSON_NUTRIENT'",' "$GOALS_FILE"
        echo -e "${GREEN}✓ Updated Goals component${OFF}"
        
        # Validate the change
        if ! grep -q "\"$JSON_NUTRIENT\"" "$GOALS_FILE"; then
            echo -e "${RED}✗ Failed to add $JSON_NUTRIENT to Goals component${OFF}"
            exit 1
        fi
    else
        echo -e "${RED}✗ Could not find dha_mg in Goals component${OFF}"
        exit 1
    fi
else
    echo -e "${RED}✗ $GOALS_FILE not found${OFF}"
    exit 1
fi

echo
if [[ "$DRY_RUN" == true ]]; then
    echo -e "${BLUE}🔍 Dry run complete!${OFF}"
    echo -e "${YELLOW}No changes were made. Run without --dry-run to apply changes.${OFF}"
    exit 0
fi

echo -e "${BLUE}📋 Summary of Changes Made:${OFF}"
echo
for file in "${CHANGED_FILES[@]}"; do
    show_diff_preview "$file"
done

# Final validation
echo -e "${BLUE}🔍 Running final validation...${OFF}"
if ! validate_build; then
    echo -e "${RED}Final validation failed. Rolling back...${OFF}"
    exit 1
fi

echo
echo -e "${GREEN}🎉 Nutrient addition complete and validated!${OFF}"
echo
echo -e "${BLUE}Next steps:${OFF}"
echo "1. Run full tests: ${YELLOW}./script/test${OFF}"
echo "2. Update OpenAI nutrition prompt on portal with '$JSON_NUTRIENT': number"
echo "3. Add DRI/DV values to goals data files if available"
echo "4. Test end-to-end functionality"
echo
echo -e "${BLUE}Files successfully modified:${OFF}"
echo "- $MIGRATION_FILE (created)"
echo "- $TYPES_FILE (CompleteNutrient struct)"
echo "- $STORE_FILE (Consumption, Item, NutritionSummary structs)"  
echo "- $OPENAPI_FILE (schema definitions)"
echo "- Generated API types (regenerated)"
echo "- $GOALS_FILE (keyNutrients array)"
echo
echo -e "${YELLOW}Manual update required:${OFF}"
echo "- OpenAI nutrition prompt on portal (add JSON field and reference data)"
echo
echo -e "${GREEN}Validation passed:${OFF} All changes compile successfully!"
echo -e "${YELLOW}Don't forget to update the documentation in docs/adding-nutrients.md with your nutrient as an additional example!${OFF}"

# Clear trap since we completed successfully
trap - EXIT

# Clean up backup directory
rm -rf "$BACKUP_DIR" 2>/dev/null || true