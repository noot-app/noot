#!/usr/bin/env bash

# 📧 monalisa@birki.io / password123 (pro tier)
# 📧 alice@birki.io / password123 (free tier)

set -euo pipefail

source script/env "$@"

function usage() {
    echo "Usage: $0 [--clean | --quick | reset [--production]]"
    echo ""
    echo "Options:"
    echo "  --clean         Full reset: stop Supabase, restart, and run all migrations + seed"
    echo "  --quick         Quick reset: reset database without restarting services, run migrations + seed"
    echo "  reset           Run supabase db reset on local development database"
    echo "  reset --production  Run supabase db reset on linked production database (with warning)"
    echo ""
    echo "This script leverages Supabase's built-in seeding via supabase/seed.sql"
    echo "Creates seed users for development:"
    echo "  - monalisa@birki.io (handle: monalisa, tier: pro)"
    echo "  - alice@birki.io (handle: alice, tier: free)"
    exit 1
}

function check_requirements() {
    if ! command -v supabase &> /dev/null; then
        echo -e "${RED}❌ Supabase CLI is required but not installed${OFF}"
        echo "Install it with: brew install supabase/tap/supabase"
        exit 1
    fi
}

function confirm_production_reset() {
    echo -e "${RED}⚠️  WARNING: PRODUCTION DATABASE RESET ⚠️${OFF}"
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${OFF}"
    echo -e "${RED}This will PERMANENTLY DELETE all data in your production database!${OFF}"
    echo -e "${RED}This action cannot be undone!${OFF}"
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${OFF}"
    echo ""
    read -p "Type 'RESET_PRODUCTION_DATABASE' to confirm: " confirmation
    
    if [[ "$confirmation" != "RESET_PRODUCTION_DATABASE" ]]; then
        echo -e "${GREEN}✅ Production reset cancelled${OFF}"
        exit 0
    fi
}

function run_reset() {
    local production_flag="$1"
    
    echo -e "${BLUE}🔄 Running Supabase database reset...${OFF}"
    
    if [[ "$production_flag" == "true" ]]; then
        confirm_production_reset
        echo -e "${PURPLE}⚡ Resetting production database...${OFF}"
        supabase db reset --linked
    else
        echo -e "${PURPLE}⚡ Resetting local development database...${OFF}"
        supabase db reset
    fi
    
    echo -e "${GREEN}✅ Database reset completed${OFF}"
}

function run_clean() {
    check_requirements
    
    echo -e "${BLUE}🧹 Full clean reset: stopping Supabase, restarting, and running migrations + seed...${OFF}"
    
    supabase stop
    supabase start
    supabase db reset
    
    echo -e "${GREEN}✅ Clean reset completed${OFF}"
}

function run_quick() {
    check_requirements
    
    echo -e "${BLUE}⚡ Quick reset: resetting database without restarting services, running migrations + seed...${OFF}"
    
    supabase db reset
    
    echo -e "${GREEN}✅ Quick reset completed${OFF}"
}

function main() {
    check_requirements
    
    if [[ $# -eq 0 ]]; then
        usage
    fi
    
    case "${1}" in
        --clean)
            run_clean
            ;;
        --quick)
            run_quick
            ;;
        reset)
            local production_flag="false"
            
            # Check for --production flag
            if [[ $# -gt 1 && "${2}" == "--production" ]]; then
                production_flag="true"
            fi
            
            run_reset "$production_flag"
            ;;
        -h|--help|help)
            usage
            ;;
        *)
            echo -e "${RED}❌ Unknown option: ${1}${OFF}"
            echo ""
            usage
            ;;
    esac
}

main "$@"
