          },
          "fluoride_mg": {
            "type": "number",
            "description": "Fluoride (mg) for the specified weight"
          },
          "chloride_mg": {
            "type": "number",
            "description": "Chloride (mg) for the specified weight"
          },
          "omega3_ala_g": {
            "type": "number",
            "description": "Omega3 ALA (g) for the specified weight"
          },
          "omega3_epa_g": {
            "type": "number",
            "description": "Omega3 EPA (g) for the specified weight"
          },
          "omega3_dha_g": {
            "type": "number",
            "description": "Omega3 DHA (g) for the specified weight"
          },
          "omega6_g": {
            "type": "number",
            "description": "Omega6 (g) for the specified weight"
          },
          "creatine_mg": {
            "type": "number",
            "description": "Creatine (mg) for the specified weight"
          },
          "caffeine_mg": {
            "type": "number",
