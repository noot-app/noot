{
  "name": "nutrition_info_grams",
  "strict": true,
  "schema": {
    "type": "object",
    "properties": {
      "success": {
        "type": "boolean",
        "description": "Indicates if fetching nutrition info was successful. True if at least one nutrient could be found, false if no nutrients could be found or input was irrelevant."
      },
      "message": {
        "type": [
          "string",
          "null"
        ],
        "description": "Optional message describing why fetching nutrition info failed. Always null if success is true."
      },
      "nutrients": {
        "type": "object",
        "properties": {
          "calories": {
            "type": "number",
            "description": "Total energy content (kcal) for the specified weight"
          },
          "protein_g": {
            "type": "number",
            "description": "Total protein (g) for the specified weight"
          },
          "total_fat_g": {
            "type": "number",
            "description": "Total fat (g) for the specified weight"
          },
          "saturated_fat_g": {
            "type": "number",
            "description": "Saturated fat (g) for the specified weight"
          },
          "trans_fat_g": {
            "type": "number",
            "description": "Trans fat (g) for the specified weight"
          },
          "cholesterol_mg": {
            "type": "number",
            "description": "Cholesterol (mg) for the specified weight"
          },
          "sodium_mg": {
            "type": "number",
            "description": "Sodium (mg) for the specified weight"
          },
          "total_carbs_g": {
            "type": "number",
            "description": "Total carbohydrate (g) for the specified weight"
          },
          "dietary_fiber_g": {
            "type": "number",
            "description": "Total dietary fiber (g) for the specified weight"
          },
          "total_sugars_g": {
            "type": "number",
            "description": "Total sugars (g) for the specified weight"
          },
          "added_sugars_g": {
            "type": "number",
            "description": "Added sugars (g) for the specified weight"
          },
          "vitamin_a_mcg": {
            "type": "number",
            "description": "Vitamin A (mcg RAE) for the specified weight"
          },
          "vitamin_c_mg": {
            "type": "number",
            "description": "Vitamin C (mg) for the specified weight"
          },
          "vitamin_d_mcg": {
            "type": "number",
            "description": "Vitamin D (mcg) for the specified weight"
          },
          "vitamin_e_mg": {
            "type": "number",
            "description": "Vitamin E (mg alpha-tocopherol) for the specified weight"
          },
          "vitamin_k_mcg": {
            "type": "number",
            "description": "Vitamin K (mcg) for the specified weight"
          },
          "thiamine_mg": {
            "type": "number",
            "description": "Thiamine (vitamin B1, mg) for the specified weight"
          },
          "riboflavin_mg": {
            "type": "number",
            "description": "Riboflavin (vitamin B2, mg) for the specified weight"
          },
          "niacin_mg": {
            "type": "number",
            "description": "Niacin (mg) for the specified weight"
          },
          "vitamin_b6_mg": {
            "type": "number",
            "description": "Vitamin B6 (mg) for the specified weight"
          },
          "folate_mcg": {
            "type": "number",
            "description": "Folate (mcg DFE) for the specified weight"
          },
          "vitamin_b12_mcg": {
            "type": "number",
            "description": "Vitamin B12 (mcg) for the specified weight"
          },
          "biotin_mcg": {
            "type": "number",
            "description": "Biotin (mcg) for the specified weight"
          },
          "pantothenic_acid_mg": {
            "type": "number",
            "description": "Pantothenic acid (mg) for the specified weight"
          },
          "choline_mg": {
