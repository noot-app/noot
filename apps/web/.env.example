# API Configuration for Noot
PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# App Configuration  
PUBLIC_APP_NAME=Noot

# Supabase settings - Replace with your project credentials
PUBLIC_SUPABASE_URL='https://your-project.supabase.co'
PUBLIC_SUPABASE_ANON_KEY='your-anon-key-here'

# # Stripe settings (legacy - can be removed for noot)
# PRIVATE_STRIPE_API_KEY='REPLACE_ME'

# Optional - settings for email

# Email address admin messages will be sent to
# PRIVATE_ADMIN_EMAIL='your_email@example.com'
# Email address messages will be sent from
# PRIVATE_FROM_ADMIN_EMAIL='no_reply@example.com'
# Resend API key
# PRIVATE_RESEND_API_KEY='your_resend_api_key'

# Capacitor Configuration - REQUIRED for mobile apps
# This is your production Cloudflare Workers/Pages URL
# The mobile app will load everything remotely from this URL
CAPACITOR_REMOTE_URL='https://your-app.pages.dev'
