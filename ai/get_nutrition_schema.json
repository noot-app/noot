          "vitamin_d_mcg",
          "vitamin_e_mg",
          "vitamin_k_mcg",
          "thiamine_mg",
          "riboflavin_mg",
          "niacin_mg",
          "vitamin_b6_mg",
          "folate_mcg",
          "vitamin_b12_mcg",
          "biotin_mcg",
          "pantothenic_acid_mg",
          "choline_mg",
          "calcium_mg",
          "iron_mg",
          "magnesium_mg",
          "phosphorus_mg",
          "potassium_mg",
          "zinc_mg",
          "copper_mg",
          "manganese_mg",
          "selenium_mcg",
          "iodine_mcg",
          "molybdenum_mcg",
          "chromium_mcg",
          "fluoride_mg",
          "chloride_mg",
          "omega3_ala_g",
          "omega3_epa_g",
          "omega3_dha_g",
          "omega6_g",
          "creatine_mg",
          "caffeine_mg",
          "alcohol_g",
          "polyunsaturated_fat_g",
          "monounsaturated_fat_g"
        ],
        "additionalProperties": false
      },
      "url": {
        "type": [
          "string",
          "null"
        ],
        "description": "URL of the product page on Open Food Facts (or other nutrition provider), if available"
      },
      "ingredients": {
        "type": "array",
        "description": "Array of ingredients with their properties from Open Food Facts (top-level only) or inferred ingredients from best judgment. Ordered by estimated percentage (highest to lowest).",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "Ingredient ID from Open Food Facts (e.g., 'en:filtered-water')"
            },
            "text": {
              "type": "string", 
              "description": "Display name of the ingredient (e.g., 'Purified water')"
            },
            "percent_estimate": {
              "type": ["number", "null"],
              "description": "Estimated percentage of this ingredient in the product"
            }
          },
          "required": ["id", "text", "percent_estimate"],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "success",
      "message",
      "nutrients",
      "ingredients",
      "url"
    ],
    "additionalProperties": false
  }
}
