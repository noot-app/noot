#!/usr/bin/env bash

set -euo pipefail

source script/env "$@"

function usage() {
    echo "Usage: $0 [--clean | --clean-full]"
    echo ""
    echo "Options:"
    echo "  --clean       Quick database reset (clear tables and reseed, keep services running)"
    echo "  --clean-full  Full reset (stop/restart services, then clean and reseed)"
    echo ""
    echo "Without options, starts the server with the existing database."
    exit 1
}

function quick_clean_and_start() {
    echo -e "${BLUE}🧹 Quick cleaning database and starting server...${OFF}"
    
    # Load .env file to detect database provider
    if [[ -f .env ]]; then
        set -a
        source <(grep -v '^#' .env | grep -v '^$' | sed 's/^/export /')
        set +a
    fi
    
    # Determine database provider
    DATABASE_PROVIDER="${DATABASE_PROVIDER:-sqlite}"
    
    if [[ "$DATABASE_PROVIDER" == "supabase" ]]; then
        echo -e "${BLUE}Step 1: Quick cleaning Supabase database (keeping services running)${OFF}"
        script/supabase-seed --quick
    else
        # SQLite flow
        echo -e "${BLUE}Step 1: Resetting database${OFF}"
        script/db reset
        
        echo -e "${BLUE}Step 2: Seeding database${OFF}"
        script/db seed
    fi
    
    echo -e "${GREEN}✅ Database quickly cleaned and seeded${OFF}"
    echo -e "${BLUE}🚀 Starting server...${OFF}"
    echo ""
    
    # Start the server
    go run ./cmd/noot/main.go
}

function full_clean_and_start() {
    echo -e "${BLUE}🧹 Full cleaning (stop/restart services) and starting server...${OFF}"
    
    # Load .env file to detect database provider
    if [[ -f .env ]]; then
        set -a
        source <(grep -v '^#' .env | grep -v '^$' | sed 's/^/export /')
        set +a
    fi
    
    # Determine database provider
    DATABASE_PROVIDER="${DATABASE_PROVIDER:-sqlite}"
    
    if [[ "$DATABASE_PROVIDER" == "supabase" ]]; then
        echo -e "${BLUE}Step 1: Full cleaning and seeding Supabase (stop/restart services)${OFF}"
        script/supabase-seed --clean
    else
        # SQLite flow (same as quick clean for SQLite)
        echo -e "${BLUE}Step 1: Resetting database${OFF}"
        script/db reset
        
        echo -e "${BLUE}Step 2: Seeding database${OFF}"
        script/db seed
    fi
    
    echo -e "${GREEN}✅ Database fully cleaned and seeded${OFF}"
    echo -e "${BLUE}🚀 Starting server...${OFF}"
    echo ""
    
    # Start the server
    go run ./cmd/noot/main.go
}

function start_server() {
    echo -e "${BLUE}🚀 Starting server...${OFF}"
    go run ./cmd/noot/main.go
}

# Parse command line arguments
case "${1:-}" in
    --clean)
        quick_clean_and_start
        ;;
    --clean-full)
        full_clean_and_start
        ;;
    --help|-h)
        usage
        ;;
    "")
        start_server
        ;;
    *)
        echo "Unknown option: $1"
        echo ""
        usage
        ;;
esac
