#!/usr/bin/env bash

set -euo pipefail

source script/env "$@"

# Check if --ci flag is provided
CI_MODE=false
if [[ " $* " == *" --ci "* ]]; then
    CI_MODE=true
fi

STATUS=0
assert-nothing-changed() {
    local diff
    "$@" >/dev/null || return 1
    if ! diff="$(git diff -U1 --color --exit-code)"; then
    printf '\e[31mError: running `\e[1m%s\e[22m` results in modifications that you must check into version control:\e[0m\n%s\n\n' "$*" "$diff" >&2
    STATUS=1
    fi
}

# Run go fmt
go fmt -mod=vendor ./...

# In CI mode, check if formatting changes were made
if $CI_MODE; then
    assert-nothing-changed true  # Just check git diff without running anything
fi

exit $STATUS
