#!/usr/bin/env bash

set -euo pipefail

source script/env "$@"

function usage() {
    echo "Usage: $0 [--clean | --quick]"
    echo ""
    echo "Options:"
    echo "  --clean    Full reset: stop Supabase, restart, and run all migrations + seed"
    echo "  --quick    Quick reset: reset database without restarting services, run migrations + seed"
    echo ""
    echo "This script leverages Supabase's built-in seeding via supabase/seed.sql"
    echo "Creates seed users for development:"
    echo "  - monalisa@birki.io (handle: monalisa, tier: pro)"
    echo "  - alice@birki.io (handle: alice, tier: free)"
    exit 1
}

function check_requirements() {
    if ! command -v supabase &> /dev/null; then
        echo -e "${RED}❌ Supabase CLI is required but not installed${OFF}"
        echo "Install it with: npm install -g supabase"
        exit 1
    fi
}

function clean_supabase() {
    echo -e "${BLUE}🧹 Full Supabase reset (with service restart)...${OFF}"
    
    # Stop and restart Supabase to get a clean state
    echo -e "${BLUE}  Stopping Supabase...${OFF}"
    supabase stop --all --no-backup || true
    
    echo -e "${BLUE}  Starting Supabase...${OFF}"
    supabase start
    
    # Wait a moment for services to be ready
    sleep 3
    
    # Reset database with migrations and seed
    echo -e "${BLUE}  Resetting database with migrations and seed...${OFF}"
    supabase db reset --local
    
    echo -e "${GREEN}✅ Supabase fully reset with seed data${OFF}"
}

function quick_clean_supabase() {
    echo -e "${BLUE}🧹 Quick Supabase reset (services keep running)...${OFF}"
    
    # Reset database without restarting services
    echo -e "${BLUE}  Resetting database with migrations and seed...${OFF}"
    supabase db reset --local
    
    echo -e "${GREEN}✅ Supabase database reset with seed data${OFF}"
}

function main() {
    check_requirements
    
    case "${1:-}" in
        --clean)
            clean_supabase
            ;;
        --quick)
            quick_clean_supabase
            ;;
        --help|-h)
            usage
            ;;
        "")
            # Default: just reset without restarting services
            quick_clean_supabase
            ;;
        *)
            echo -e "${RED}❌ Unknown option: $1${OFF}"
            usage
            ;;
    esac
    
    echo ""
    echo -e "${BLUE}You can now login with:${OFF}"
    echo "  📧 monalisa@birki.io / password123 (pro tier)"
    echo "  📧 alice@birki.io / password123 (free tier)"
}

main "$@"
