          },
          "polyunsaturated_fat_g": {
            "type": "number",
            "description": "Polyunsaturated fat (g) for the specified weight"
          },
          "monounsaturated_fat_g": {
            "type": "number",
            "description": "Monounsaturated fat (g) for the specified weight"
