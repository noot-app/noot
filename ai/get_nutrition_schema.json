          },
          "iron_mg": {
            "type": "number",
            "description": "Iron (mg) for the specified weight"
          },
          "magnesium_mg": {
            "type": "number",
            "description": "Magnesium (mg) for the specified weight"
          },
          "phosphorus_mg": {
            "type": "number",
            "description": "Phosphorus (mg) for the specified weight"
          },
          "potassium_mg": {
            "type": "number",
            "description": "Potassium (mg) for the specified weight"
          },
          "zinc_mg": {
            "type": "number",
            "description": "Zinc (mg) for the specified weight"
          },
          "copper_mg": {
            "type": "number",
            "description": "Copper (mg) for the specified weight"
          },
          "manganese_mg": {
            "type": "number",
            "description": "Manganese (mg) for the specified weight"
          },
          "selenium_mcg": {
            "type": "number",
            "description": "Selenium (mcg) for the specified weight"
          },
          "iodine_mcg": {
            "type": "number",
            "description": "Iodine (mcg) for the specified weight"
          },
